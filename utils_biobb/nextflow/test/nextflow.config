outputDir = 'results'

process {
    withName: 'BIOBB_GROMACS_GROMPP' {
        ext.properties = [simulation_type: 'minimization', maxwarn: 1, mdp: [nsteps: 100]]
    }
    withName: 'BIOBB_GROMACS_MDRUN' {
        cpus = 2
        ext.outputs = [output_xtc_path: false, output_dhdl_path: false]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled = true
    }
}
