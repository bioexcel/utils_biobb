<tool id="biobb_dna_dna_timeseries_unzip_ext" name="DnaTimeseriesUnzip" version="5.3.0" >
    <description>: Tool for extracting dna_timeseries output files.</description>
    <requirements>
        <requirement type="package"
        version="5.3.0"
        >biobb_dna</requirement>
    </requirements>
    <command detect_errors="aggressive"><![CDATA[
        
          ln -f -s ${input_zip_file} ${input_zip_file}_`echo $$`.${input_zip_file.ext};
        
        #if $config.sele == "option1":
            ln -s -f ${config.properties} ${config.properties}_`echo $$`.${config.properties.ext};
          #end if

        dna_timeseries_unzip

        #if $config.sele == "option1":
            --config ${config.properties}_`echo $$`.${config.properties.ext}
          #else if $config.sele == "option2":
            --config '${config.jsonstr}'
          #else if $config.sele == "option3":
            --config '__oc____dq__properties__dq__:__oc____dq__type__dq__:__dq__${properties.type}__dq__,__dq__parameter__dq__:__dq__${properties.parameter}__dq__,__dq__sequence__dq__:__dq__${properties.sequence}__dq__,__dq__index__dq__:${properties.index}__cc____cc__'
          #end if
        
          #if str($input_zip_file) != 'None':
            --input_zip_file ${input_zip_file}_`echo $$`.${input_zip_file.ext}
          #end if
        
        
          --output_path_csv $outname_output_path_csv
        
          --output_path_jpg $outname_output_path_jpg
        
          --output_list_path $outname_output_list_path
        ;
        #if $config.sele == "option1":
            rm -f ${config.properties}_`echo $$`.${config.properties.ext};
          #end if
        
          rm -f ${input_zip_file}_`echo $$`.${input_zip_file.ext};
        
        
          if test -f $outname_output_path_csv; then mv $outname_output_path_csv $output_path_csv; fi;
        
          if test -f $outname_output_path_jpg; then mv $outname_output_path_jpg $output_path_jpg; fi;
        
          if test -f $outname_output_list_path; then mv $outname_output_list_path $output_list_path; fi;
        
    ]]>
    </command>
    <inputs>
        
          <param name="input_zip_file" type="data" format="zip"  optional="False" label="input ZIP file" help="Zip file with dna_timeseries output files. Format: [input].zip"/>
        
        
          <param name="outname_output_path_csv" type="text" value="mydna_timeseries_unzip.csv"
              optional="False" label="output CSV name"
              help="dna_timeseries output csv file contained within input_zip_file Format: [output].csv "/>
        
          <param name="outname_output_path_jpg" type="text" value="mydna_timeseries_unzip.jpg"
              optional="False" label="output JPG name"
              help="dna_timeseries output jpg file contained within input_zip_file Format: [output].jpg "/>
        
          <param name="outname_output_list_path" type="text" value="mydna_timeseries_unzip.txt"
              optional="True" label="output TXT name"
              help="Text file with a list of all dna_timeseries output files contained within input_zip_file Format: [output].txt "/>
        
        <conditional name="config">
            <param name="sele" type="select" label="Take tool settings:" help="Select where tool settings are to be read from">
              <option value="option3">Manual Input</option>
              <option value="option1">from configuration file</option>
              <option value="option2">from JSON string</option>
            </param>
            <when value="option1">
              <param name="properties" type="data" format="yml,json" optional="false" label="Configuration file" help="File containing tool settings. See below for the syntax"/>
            </when>
            <when value="option2">
              <param name="jsonstr" type="text" value="{}" optional="false" label="JSON string" help="JSON string containing tool settings. See below for the syntax"/>
            </when>
            <when value="option3">
            </when>
          </conditional>
          <section name="properties" title="Properties Input">
            
