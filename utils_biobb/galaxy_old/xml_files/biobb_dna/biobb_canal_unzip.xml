                    </option>
                  
                    <option value="zetaC"
                      
                    >zetaC
                       
                    </option>
                  
                    <option value="zetaW"
                      
                    >zetaW
                       
                    </option>
                  
                </param>
            
              <param name="correlation" type="text" label="correlation" help="Correlation indexes separated by underscore (ie &#39;98_165&#39;), only for &#39;corr&#39; type." optional="true"
                  
                >
                  <sanitizer><valid initial="string.printable"/></sanitizer>
                </param>
            
              <param name="output_format" type="select" label="output_format" help="Format of the output file" multiple="false">
                  
                    <option value="ser"
                      
                    >ser
                       
                    </option>
                  
                    <option value="his"
                      
                    >his
                       
                    </option>
                  
                    <option value="cor"
                      
                    >cor
                       
                    </option>
                  
                </param>
            
          </section>
    </inputs>
    <outputs>
        
        <data name="output_path" format="text" label="${outname_output_path}">
            <change_format>
            
            <when input="properties.output_format" value="ser" format="ser" />
            
            <when input="properties.output_format" value="his" format="his" />
            
            <when input="properties.output_format" value="cor" format="cor" />
            
            </change_format>
          </data>
        
        
          <data name="output_list_path" format="txt" label="${outname_output_list_path}"/>
        
    </outputs>
    <tests>
        <test>
          <param name="sele" value="option1"/>
          <param name="properties" value="data/config/config_editconf.json"/>
        </test>
    </tests>
