<tool id="biobb_dna_canal_unzip_ext" name="CanalUnzip" version="5.3.0" >
    <description>: Tool for extracting biobb_canal output files.</description>
    <requirements>
        <requirement type="package"
        version="5.3.0"
        >biobb_dna</requirement>
    </requirements>
    <command detect_errors="aggressive"><![CDATA[
        
          ln -f -s ${input_zip_file} ${input_zip_file}_`echo $$`.${input_zip_file.ext};
        
        #if $config.sele == "option1":
            ln -s -f ${config.properties} ${config.properties}_`echo $$`.${config.properties.ext};
          #end if

        canal_unzip

        #if $config.sele == "option1":
            --config ${config.properties}_`echo $$`.${config.properties.ext}
          #else if $config.sele == "option2":
            --config '${config.jsonstr}'
          #else if $config.sele == "option3":
            --config '__oc____dq__properties__dq__:__oc____dq__type__dq__:__dq__${properties.type}__dq__,__dq__helpar_name__dq__:__dq__${properties.helpar_name}__dq__,__dq__correlation__dq__:__dq__${properties.correlation}__dq____cc____cc__'
          #end if
        
          #if str($input_zip_file) != 'None':
            --input_zip_file ${input_zip_file}_`echo $$`.${input_zip_file.ext}
          #end if
        
        
          --output_path $outname_output_path
        
          --output_list_path $outname_output_list_path
        ;
        #if $config.sele == "option1":
            rm -f ${config.properties}_`echo $$`.${config.properties.ext};
          #end if
        
          rm -f ${input_zip_file}_`echo $$`.${input_zip_file.ext};
        
        
          if test -f $outname_output_path; then mv $outname_output_path $output_path; fi;
        
          if test -f $outname_output_list_path; then mv $outname_output_list_path $output_list_path; fi;
        
    ]]>
    </command>
    <inputs>
        
          <param name="input_zip_file" type="data" format="zip"  optional="False" label="input ZIP file" help="Zip file with Canal output files. Format: [input].zip"/>
        
        
          <param name="outname_output_path" type="text" value="mycanal_unzip.ser"
              optional="False" label="output SER,HIS,COR name"
              help="Canal output file contained within input_zip_file Format: [output].[format] "/>
        
          <param name="outname_output_list_path" type="text" value="mycanal_unzip.txt"
              optional="True" label="output TXT name"
              help="Text file with a list of all Canal output files contained within input_zip_file Format: [output].txt "/>
        
        <conditional name="config">
            <param name="sele" type="select" label="Take tool settings:" help="Select where tool settings are to be read from">
              <option value="option3">Manual Input</option>
              <option value="option1">from configuration file</option>
              <option value="option2">from JSON string</option>
            </param>
            <when value="option1">
              <param name="properties" type="data" format="yml,json" optional="false" label="Configuration file" help="File containing tool settings. See below for the syntax"/>
            </when>
            <when value="option2">
              <param name="jsonstr" type="text" value="{}" optional="false" label="JSON string" help="JSON string containing tool settings. See below for the syntax"/>
            </when>
            <when value="option3">
            </when>
          </conditional>
          <section name="properties" title="Properties Input">
            
              <param name="type" type="select" label="type" help="Type of file. " multiple="false">
                  
                    <option value="series"
                      
                    >series
                       
                    </option>
                  
                    <option value="histo"
                      
                    >histo
                       
                    </option>
                  
                    <option value="corr"
                      
                    >corr
                       
                    </option>
                  
                </param>
            
              <param name="helpar_name" type="select" label="helpar_name" help="Helical parameter name, only for &#39;series&#39; and &#39;histo&#39; types. " multiple="false">
                  
                    <option value="alphaC"
                      
                    >alphaC
                       
                    </option>
                  
                    <option value="alphaW"
                      
                    >alphaW
                       
                    </option>
                  
                    <option value="ampC"
                      
                    >ampC
                       
                    </option>
                  
                    <option value="ampW"
                      
                    >ampW
                       
                    </option>
                  
                    <option value="ax-bend"
                      
                    >ax-bend
                       
                    </option>
                  
                    <option value="betaC"
                      
                    >betaC
                       
                    </option>
                  
                    <option value="betaW"
                      
                    >betaW
                       
                    </option>
                  
                    <option value="buckle"
                      
                    >buckle
                       
                    </option>
                  
                    <option value="chiC"
                      
                    >chiC
                       
                    </option>
                  
                    <option value="chiW"
                      
                    >chiW
                       
                    </option>
                  
                    <option value="curv"
                      
                    >curv
                       
                    </option>
                  
                    <option value="deltaC"
                      
                    >deltaC
                       
                    </option>
                  
                    <option value="deltaW"
                      
                    >deltaW
                       
                    </option>
                  
                    <option value="epsilC"
                      
                    >epsilC
                       
                    </option>
                  
                    <option value="epsilW"
                      
                    >epsilW
                       
                    </option>
                  
                    <option value="gammaC"
                      
                    >gammaC
                       
                    </option>
                  
                    <option value="gammaW"
                      
                    >gammaW
                       
                    </option>
                  
                    <option value="h-ris"
                      
                    >h-ris
                       
                    </option>
                  
                    <option value="h-twi"
                      
                    >h-twi
                       
                    </option>
                  
                    <option value="inclin"
                      
                    >inclin
                       
                    </option>
                  
                    <option value="majd"
                      
                    >majd
                       
                    </option>
                  
                    <option value="majw"
                      
                    >majw
                       
                    </option>
                  
                    <option value="mind"
                      
                    >mind
                       
                    </option>
                  
                    <option value="minw"
                      
                    >minw
                       
                    </option>
                  
                    <option value="opening"
                      
                    >opening
                       
                    </option>
                  
                    <option value="phaseC"
                      
                    >phaseC
                       
                    </option>
                  
                    <option value="phaseW"
                      
                    >phaseW
                       
                    </option>
                  
                    <option value="propel"
                      
                    >propel
                       
                    </option>
                  
                    <option value="reg"
                      
                    >reg
                       
                    </option>
                  
                    <option value="rise"
                      
                    >rise
                       
                    </option>
                  
                    <option value="roll"
                      
                    >roll
                       
                    </option>
                  
                    <option value="shear"
                      
                    >shear
                       
                    </option>
                  
                    <option value="shift"
                      
                    >shift
                       
                    </option>
                  
                    <option value="slide"
                      
                    >slide
                       
                    </option>
                  
                    <option value="stagger"
                      
                    >stagger
                       
                    </option>
                  
                    <option value="stretch"
                      
                    >stretch
                       
                    </option>
                  
                    <option value="tbend"
                      
                    >tbend
                       
                    </option>
                  
                    <option value="tilt"
                      
                    >tilt
                       
                    </option>
                  
                    <option value="tip"
                      
